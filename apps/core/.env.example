DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nano_agents

# Public HTTPS URL (Cloudflare Tunnel or reverse proxy). Must match mobile EXPO_PUBLIC_CORE_URL.
BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_TRUSTED_ORIGINS=
# Required, at least 32 characters. Generate: openssl rand -hex 32
# It signs sessions and seals stored API keys: keep it, and keep it secret.
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

HOST=0.0.0.0
PORT=3000
# A tunnel or reverse proxy on this machine is trusted by default. Set to 1 when
# the proxy runs on another host, or 0 to ignore forwarded client addresses.
# TRUST_PROXY=1

# The Docker runtime for agent containers. Leave unset on a Mac (plain Docker).
# On a Linux server with Kata Containers installed, name its runtime here so
# each account's container runs in its own small virtual machine.
# CONTAINER_RUNTIME=kata

# Agent containers may reach the public internet only. The rules are placed
# automatically: inside each container's network (netns) with plain Docker, on
# the host (host) with a virtual-machine runtime. Setting this to off lets every
# agent reach this machine's database and local network.
# CONTAINER_FIREWALL=off
# Name servers for containers when the rules are on the host.
# CONTAINER_DNS=1.1.1.1,8.8.8.8

# production | development (production requires HTTPS BETTER_AUTH_URL + Google OAuth)
# NODE_ENV=production

LOG_LEVEL=info
SKILLS_DIR=../../skills

# Optional shared search keys (per-account keys override when set)
# EXA_API_KEY=
# BRAVE_API_KEY=

# Optional semantic recall. Memory search always works through Postgres full text;
# these add vector similarity on top. The key is read from the account's provider
# key of this name, and the model must return 1536-dimension vectors.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Optional fixed model for every account's default agent, as provider:modelId.
# Unset, it uses the default model the person chooses during setup.
# SUPPORT_AGENT_MODEL=anthropic:claude-sonnet-5-5
