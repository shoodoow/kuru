{
  "name": "core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file .env src/main.ts",
    "test": "vitest run",
    "migrate": "node dist/db/migrate.js",
    "db:migrate": "tsx --env-file .env src/db/migrate.ts",
    "db:reset": "tsx --env-file .env src/db/reset-db.ts --yes",
    "tunnel": "cloudflared tunnel run local",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/xai": "5.0.10",
    "@better-auth/expo": "1.6.23",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mozilla/readability": "^0.6.0",
    "@kuru/agent-tools": "workspace:*",
    "@kuru/shared": "workspace:*",
    "@novnc/novnc": "1.7.0",
    "ai": "7.0.118",
    "better-auth": "1.7.10",
    "dockerode": "5.0.1",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jsdom": "^30.1.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "turndown": "^7.2.4",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.40",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
