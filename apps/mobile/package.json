    "expo": "57.0.25",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "^57.0.19",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "^57.0.5",
