    "expo": "58.0.7",
    "expo-asset": "~58.0.13",
    "expo-blur": "~58.0.3",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "^58.0.10",
    "expo-document-picker": "^58.0.4",
    "expo-file-system": "^58.0.8",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.5",
    "expo-image": "^58.0.13",
