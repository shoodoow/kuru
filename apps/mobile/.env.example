# Copy to `.env` in this folder (gitignored). Restart Expo after changes.
# Phone on any network: public HTTPS URL (same as apps/core BETTER_AUTH_URL), e.g. Cloudflare Tunnel.
# Local emulator only: use `pnpm android` (10.0.2.2) or http://127.0.0.1:3000 on simulator.
EXPO_PUBLIC_CORE_URL=https://api.example.com

# The address above is only the default. Anyone can change it on the sign-in
# screen ("Server"), so one build works with any self-hosted server.
# Set this to 1 for a build that may talk to a plain http server on a local
# network; without it Android allows https only (unless the default is http).
# EXPO_PUBLIC_ALLOW_HTTP=1
