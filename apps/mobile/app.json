{
  "expo": {
    "name": "Kuru",
    "slug": "nano-agents",
    "scheme": "kuru",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47834947-adeb-4aa2-b980-bc72ac43be47"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "eas": {
      "projectId": "47834947-adeb-4aa2-b980-bc72ac43be47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kurubot.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow Kuru to save photos and videos from chats."
      }
    },
    "android": {
      "package": "com.kurubot.app",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "kuru" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/with-scene-lifecycle",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Kuru to save pictures and videos to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      ["expo-notifications", { "defaultChannel": "default" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kuru to attach photos to messages.",
          "cameraPermission": "Allow Kuru to take photos for messages."
        }
      ]
    ]
  }
}
